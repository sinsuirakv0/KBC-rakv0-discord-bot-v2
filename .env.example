DISCORD_TOKEN=

# 通知設定を保存するprivate GitHub Repository（Contents: Read and write）
GITHUB_DATA_OWNER=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main
GITHUB_DATA_TOKEN=

# 更新検知の受信（未設定なら受信サーバーを起動しない）
EVENT_UPDATE_SECRET=
EVENT_UPDATE_PORT=3000
EVENT_UPDATE_HOST=0.0.0.0

# Bot status（TokenにはService閲覧・Observability閲覧権限が必要）
# Project / Service IDはNorthflank上では自動注入値を使用
NORTHFLANK_API_TOKEN=
# Local実行時だけ指定
NORTHFLANK_PROJECT_ID=
NORTHFLANK_SERVICE_ID=
# 初回V2 DeploymentをAPI履歴から取得できない場合だけ指定
BOT_UPTIME_STARTED_AT=
